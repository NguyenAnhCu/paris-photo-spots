NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pmv:pmv@localhost:5433/pmv
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=1h
MAX_RADIUS_M=5000
MAX_RESULTS=500
MAX_POLYGON_VERTICES=1000
TILE_CACHE_SECONDS=300
JSON_BODY_LIMIT=200kb
SPOT_DUPLICATE_RADIUS_M=30
SPOT_NAME_MIN_LENGTH=3
SPOT_NAME_MAX_LENGTH=120
SPOT_TIP_MAX_LENGTH=1000
SPOT_LIST_THUMB_WIDTH=500
WALK_METERS_PER_MINUTE=80
MAX_WALK_METERS=2000
STORAGE_DIR=storage
MEDIA_CACHE_SECONDS=31536000
MAX_UPLOAD_MB=10
IMAGE_MAX_EDGE=2048
THUMB_EDGE=400
IMAGE_JPEG_QUALITY=82
WRITE_RATE_LIMIT=20
WRITE_RATE_WINDOW_MINUTES=15
