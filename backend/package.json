{
  "name": "@pmv/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "migrate:up": "node-pg-migrate up --migrations-dir db/migrations --envPath .env",
    "migrate:down": "node-pg-migrate down --migrations-dir db/migrations --envPath .env",
    "seed": "tsx --env-file=.env db/seeds/seed.ts",
    "import": "tsx --env-file=.env db/import/run.ts",
    "import:report": "tsx --env-file=.env db/import/report.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^2.0.5",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "node-pg-migrate": "^8.0.0",
    "pbf": "^4.0.2",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
